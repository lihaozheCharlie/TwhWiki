{
  "name": "@the-way-here/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node22 --out-dir dist --clean --no-splitting",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@fastify/static": "^8.2.0",
    "@the-way-here/codex-bridge": "workspace:*",
    "@the-way-here/life-views": "workspace:*",
    "@the-way-here/run-manager": "workspace:*",
    "@the-way-here/shared": "workspace:*",
    "@the-way-here/wiki-core": "workspace:*",
    "chokidar": "^4.0.3",
    "fastify": "^5.6.1",
    "sharp": "^0.35.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
