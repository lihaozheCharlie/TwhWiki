{
  "name": "@the-way-here/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open",
    "build": "npm run design:check && tsc --noEmit && vite build",
